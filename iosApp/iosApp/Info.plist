<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ar</string>
	<key>CFBundleDisplayName</key>
	<string>Mizan</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ar</string><string>en</string><string>fr</string><string>tr</string><string>ur</string><string>id</string>
		<string>ms</string><string>fa</string><string>bn</string><string>ru</string><string>de</string><string>es</string>
		<string>uk</string><string>uz</string><string>kk</string>
	</array>
	<!-- حاوية المشاركة مع أدوات الشاشة الرئيسية (اقرأ IosWidgets.kt) -->
	<key>MizanAppGroup</key>
	<string>group.com.mizan.almuslim</string>
	<!-- روابط الأدوات: mizan://open?route=adhkar&amp;section=morning -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.mizan.almuslim</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mizan</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Compose يرسم بمعدل الشاشة الكامل (120 هرتز في ProMotion) -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- النص المترجم لكل لغة في iosApp/<lang>.lproj/InfoPlist.strings؛ هذا احتياط -->
	<!-- مشاركة الآية صورة: «حفظ الصورة» في قائمة المشاركة يضيفها إلى الصور (إضافة فقط، بلا قراءة) -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>لحفظ صورة الآية التي تشاركها في تطبيق الصور. To save the ayah image you share to your Photos.</string>
	<!-- مواقيت الصلاة في تقويم خاص بها (EventKit): iOS 17 فما بعد، وما قبله -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>لإضافة مواقيت الصلاة إلى تقويم خاص بها على جهازك وتحديثها. To add prayer times to their own calendar on your device and keep them up to date.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>لإضافة مواقيت الصلاة إلى تقويم خاص بها على جهازك وتحديثها. To add prayer times to their own calendar on your device and keep them up to date.</string>
	<!-- القبلة بالكاميرا (ARKit): الكاميرا على الجهاز فقط، بلا تصوير ولا حفظ -->
	<key>NSCameraUsageDescription</key>
	<string>تُستعمل الكاميرا على جهازك فقط لإظهار اتجاه القبلة فوق ما تراه. The camera is used only on your device to show the qibla direction over what you see.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>يُستعمل موقعك على جهازك فقط لحساب مواقيت الصلاة واتجاه القبلة. Your location is used on your device only to compute prayer times and the qibla.</string>
	<!-- تلاوة القرآن (ClipPlayer: AVAudioSessionCategoryPlayback) تستمر وإن أُطفئت الشاشة أو خرج المستخدم من التطبيق.
	     الأذان داخل التطبيق لا يحتاجها (SoloAmbient)، وأذان الإشعار صوت إشعار عادي. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<!-- إنهاء العدّ التنازلي الحي بعد دخول الوقت والتطبيق معلّق (BGAppRefreshTask في LiveActivities.swift) -->
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.mizan.almuslim.live</string>
	</array>
	<!-- الأنشطة الحية: العدّ التنازلي للصلاة القادمة و«يُتلى الآن» على شاشة القفل وفي الجزيرة الديناميكية -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- دورة حياة المشاهد (إلزامية بعد iOS 26 SDK)؛ يضبط AppDelegate الإعداد برمجياً -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- شاشة الإقلاع: أخضر التطبيق (وقاتم في الوضع الداكن) والميزان الذهبي في الوسط، ثم يذوب في الشاشة الأولى (LaunchCurtain) -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchEmblem</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<!-- iPhone بالطول فقط (الشاشة الداخلية لـ iPhone Duo يتجاهل فيها النظام هذا، والواجهة تتكيف مع أي نسبة) -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- iPad بالاتجاهات الأربعة، ومعها Split View و Slide Over ونوافذ iPadOS (لا UIRequiresFullScreen) -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
