<?xml version="1.0" encoding="utf-8"?>
<!--
  النسخ الاحتياطي التلقائي من النظام (أندرويد 12 فما بعد): إلى حساب Google، وعند النقل المباشر إلى هاتف جديد.
  تُنسخ الإعدادات (mizan.xml: الإعدادات والعلامات والختمة والمسبحة)، ويُستثنى ما يُنزَّل من جديد عند الحاجة:
  خطوط مصحف المدينة، والتفاسير، وتسجيلات الأذان، وحزم اللغات؛ وحال أدوات الشاشة الرئيسية (معرّفاتها تخص الجهاز).
  الذاكرة المؤقتة (التلاوات) لا تُنسخ أصلاً. أندرويد 11 فما قبل: backup_rules.xml بالقواعد نفسها.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="madinah" />
        <exclude domain="file" path="tafsir" />
        <exclude domain="file" path="adhan" />
        <exclude domain="file" path="lang" />
        <exclude domain="sharedpref" path="mizan_widgets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="madinah" />
        <exclude domain="file" path="tafsir" />
        <exclude domain="file" path="adhan" />
        <exclude domain="file" path="lang" />
        <exclude domain="sharedpref" path="mizan_widgets.xml" />
    </device-transfer>
</data-extraction-rules>
