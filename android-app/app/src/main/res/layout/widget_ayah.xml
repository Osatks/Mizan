<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:gravity="center" android:padding="14dp">
    <TextView android:id="@+id/title" android:text="@string/widget_ayah" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#E0B54A" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/ayah" android:text="﴿إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا﴾" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:textColor="#FFFFFF" android:textSize="20sp" android:fontFamily="@font/amiri_quran"
        android:textDirection="rtl" android:lineSpacingExtra="4dp" android:maxLines="4" android:ellipsize="end" />
    <TextView android:id="@+id/meaning" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="3" android:ellipsize="end" />
    <TextView android:id="@+id/ref" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:background="@drawable/widget_pill" android:paddingHorizontal="10dp" android:paddingVertical="2dp"
        android:textColor="#FFFFFF" android:textSize="11sp" android:maxLines="1" />
</LinearLayout>
