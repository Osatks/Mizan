<?xml version="1.0" encoding="utf-8"?>
<!-- أذكار الوقت: عنوان الوقت وشارته، ثم الذكر بخط المصحف، ثم عدد التكرار والمصدر وزر الذكر التالي -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_surface" android:clipToOutline="true">
    <!-- السطح بلون التطبيق، ثم ظل التدرج، ثم لمعة ذهبية وحافة رفيعة، ثم زخرفة النجمة -->
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_surface" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_shade" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_sheen" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:layout_width="130dp" android:layout_height="130dp" android:layout_gravity="top|end"
        android:layout_marginTop="-44dp" android:layout_marginEnd="-44dp" android:alpha="0.16"
        android:src="@drawable/widget_ornament" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/icon" android:layout_width="15dp" android:layout_height="15dp" android:layout_marginEnd="6dp"
                android:src="@drawable/ic_w_sun" android:tint="@color/w_gold" android:importantForAccessibility="no" />
            <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/widget_adhkar" android:textColor="@color/w_gold" android:textSize="12sp" android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart" />
            <TextView android:id="@+id/chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:background="@drawable/widget_chip_light" android:paddingHorizontal="8dp" android:paddingVertical="1dp"
                android:textColor="@color/w_text" android:textSize="10sp" android:maxLines="1" android:visibility="gone" />
        </LinearLayout>

        <TextView android:id="@+id/text" android:text="سُبْحَانَ اللَّهِ وَبِحَمْدِهِ" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="6dp" android:gravity="center" android:textColor="@color/w_text" android:fontFamily="@font/amiri_quran"
            android:textDirection="rtl" android:lineSpacingMultiplier="1.0"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/widget_chip" android:paddingHorizontal="9dp" android:paddingVertical="2dp"
                android:textColor="@color/w_gold" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:visibility="gone" />
            <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageView android:id="@+id/next" android:layout_width="28dp" android:layout_height="28dp"
                android:background="@drawable/widget_button" android:padding="6dp" android:src="@drawable/ic_w_next" android:tint="@color/w_text"
                android:contentDescription="@string/widget_next_dhikr" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
