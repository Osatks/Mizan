<?xml version="1.0" encoding="utf-8"?>
<!-- الصلاة القادمة بعرض أربع خانات: العد التنازلي وبجانبه صلوات اليوم الخمس -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_surface" android:clipToOutline="true">
    <!-- السطح بلون التطبيق، ثم ظل التدرج، ثم لمعة ذهبية وحافة رفيعة، ثم زخرفة النجمة -->
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_surface" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_shade" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_sheen" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:layout_width="180dp" android:layout_height="180dp" android:layout_gravity="top|end"
        android:layout_marginTop="-50dp" android:layout_marginEnd="-60dp" android:alpha="0.16"
        android:src="@drawable/widget_ornament" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:padding="@dimen/w_pad">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1"
            android:orientation="vertical" android:layout_marginEnd="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/icon" android:layout_width="15dp" android:layout_height="15dp" android:layout_marginEnd="6dp"
                android:src="@drawable/ic_w_mosque" android:tint="@color/w_gold" android:importantForAccessibility="no" />
            <TextView android:id="@+id/label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/widget_next_prayer" android:textColor="@color/w_gold" android:textSize="12sp" android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart" />
        </LinearLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="36dp"
                android:text="@string/sample_prayer" android:textColor="@color/w_text" android:textStyle="bold"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="30sp"
                android:maxLines="1" android:gravity="center_vertical|start" android:textAlignment="viewStart" />
            <TextView android:id="@+id/time" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="3:21" android:textColor="@color/w_text2" android:textSize="13sp" android:maxLines="1" android:textAlignment="viewStart" />
            <Chronometer android:id="@+id/countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="@color/w_gold" android:textSize="28sp" android:fontFamily="sans-serif-light"
                android:fontFeatureSettings="tnum" android:countDown="true" android:maxLines="1" android:textDirection="ltr" />
            <ProgressBar android:id="@+id/progress" style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp"
                android:max="1000" android:progress="620" android:progressDrawable="@drawable/widget_progress" />
            <TextView android:id="@+id/city" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:textColor="@color/w_text3" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart" />
        </LinearLayout>
        <FrameLayout android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginVertical="6dp" android:background="#1FFFFFFF" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginStart="10dp">
            <LinearLayout android:id="@+id/r0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:layout_marginVertical="1dp">
                <TextView android:id="@+id/rn0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/sample_fajr" android:textColor="@color/w_text2" android:textSize="12sp" android:maxLines="1" android:textAlignment="viewStart" />
                <TextView android:id="@+id/rt0" android:text="4:54" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/w_text" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/r1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:layout_marginVertical="1dp">
                <TextView android:id="@+id/rn1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/sample_dhuhr" android:textColor="@color/w_text2" android:textSize="12sp" android:maxLines="1" android:textAlignment="viewStart" />
                <TextView android:id="@+id/rt1" android:text="11:54" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/w_text" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/r2" android:background="@drawable/widget_cell_on" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:layout_marginVertical="1dp">
                <TextView android:id="@+id/rn2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/sample_asr" android:textColor="@color/w_gold" android:textSize="12sp" android:maxLines="1" android:textAlignment="viewStart" />
                <TextView android:id="@+id/rt2" android:text="3:06" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/w_text" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/r3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:layout_marginVertical="1dp">
                <TextView android:id="@+id/rn3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/sample_maghrib" android:textColor="@color/w_text2" android:textSize="12sp" android:maxLines="1" android:textAlignment="viewStart" />
                <TextView android:id="@+id/rt3" android:text="5:30" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/w_text" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/r4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:layout_marginVertical="1dp">
                <TextView android:id="@+id/rn4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/sample_isha" android:textColor="@color/w_text2" android:textSize="12sp" android:maxLines="1" android:textAlignment="viewStart" />
                <TextView android:id="@+id/rt4" android:text="7:00" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/w_text" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
